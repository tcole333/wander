{
  "name": "wander-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "node scripts/check.ts",
    "gate": "node scripts/gate.ts",
    "lint": "eslint . && prettier --check --cache .",
    "format": "prettier --write .",
    "test": "sh scripts/slot.sh heavy vitest run",
    "verify:bake": "node scripts/verifyBake.ts",
    "data": "node scripts/dataServer.ts",
    "publish-data": "node scripts/publish.ts",
    "check-release": "node scripts/checkRelease.ts",
    "fixture": "uv run --directory ../pipeline --locked prebuild --profile fixture",
    "e2e": "vite build && sh scripts/slot.sh e2e playwright test --project=swiftshader",
    "e2e:gpu": "vite build && sh scripts/slot.sh e2e playwright test --project=gpu-chromium --project=gpu-alone",
    "lab": "WANDER_LAB=1 sh scripts/slot.sh e2e playwright test --project=lab"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/cormorant-sc": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "three": "0.186.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "aws4fetch": "1.0.20",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
